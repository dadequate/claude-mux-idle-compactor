#!/usr/bin/env bash
# fake-claude-mux -- stands in for the real claude-mux binary in tests, so
# parse_session_table() (and eventually the send path) can be tested without
# a real claude-mux install or a live fleet.
#
# Controlled entirely via env vars:
#   FAKE_CLAUDE_MUX_FIXTURES_DIR   dir containing status-table-<status>.txt fixtures
#   FAKE_CLAUDE_MUX_EXIT           exit code to return for `-L` calls (default 0)
#   FAKE_CLAUDE_MUX_SEND_LOG       if set, `-s SESSION 'CMD'` calls are appended here
#   FAKE_CLAUDE_MUX_SEND_EXIT      exit code to return for `-s` calls (default 0)

set -uo pipefail

if [[ "${1:-}" == "-L" ]]; then
    status="${3:-}"
    if [[ "${FAKE_CLAUDE_MUX_EXIT:-0}" != "0" ]]; then
        echo "fake-claude-mux: simulated failure" >&2
        exit "${FAKE_CLAUDE_MUX_EXIT}"
    fi
    fixture="${FAKE_CLAUDE_MUX_FIXTURES_DIR}/status-table-${status}.txt"
    if [[ -f "$fixture" ]]; then
        cat "$fixture"
    fi
    exit 0
fi

if [[ "${1:-}" == "-s" ]]; then
    session="${2:-}"
    cmd="${3:-}"
    if [[ -n "${FAKE_CLAUDE_MUX_SEND_LOG:-}" ]]; then
        echo "$session|$cmd" >> "$FAKE_CLAUDE_MUX_SEND_LOG"
    fi
    exit "${FAKE_CLAUDE_MUX_SEND_EXIT:-0}"
fi

echo "fake-claude-mux: unhandled args: $*" >&2
exit 1
